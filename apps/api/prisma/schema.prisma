// Esquema do banco de dados (Prisma).
// Dev: SQLite (arquivo local, zero instalação). Produção: troca para PostgreSQL.
// Por isso usamos texto em vez de enum nativo aqui (portável entre os dois);
// os valores válidos ficam no pacote compartilhado e são validados com Zod.

generator client {
  provider        = "prisma-client-js"
  // driverAdapters: permite rodar os TESTES de integração com a engine WASM (embutida no
  // pacote) + adapter SQLite, sem depender do download das engines nativas. Não muda nada
  // no uso normal do client (sem adapter, ele segue usando a engine nativa).
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String @id @default(cuid())
  nomeCompleto String
  email        String @unique
  senhaHash    String

  // ALUNO | PROFESSOR | AVALIADOR | COORDENADOR
  papel String

  // Só aluno: ENGENHARIA_ELETRICA | CONTROLE_E_AUTOMACAO
  curso String?

  // Professor / avaliador (titulação). Texto livre já cobre a opção "Outros".
  tratamento String?

  // Avaliador externo (instituição de origem).
  afiliacao String?

  // Professor: se está aceitando novas orientações.
  disponivelParaOrientar Boolean @default(true)

  // Versão do token de sessão: incrementada a cada troca/redefinição de senha para
  // invalidar imediatamente todas as sessões antigas (o guard compara com o token).
  versaoToken Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  tccsComoAluno        Tcc[] @relation("TccAluno")
  tccsComoOrientador   Tcc[] @relation("TccOrientador")
  tccsComoCoorientador Tcc[] @relation("TccCoorientador")
  bancasComoAvaliador  MembroBanca[]
  tokensSenha          TokenSenha[]
  preferenciasEmail    PreferenciaEmail[]
  notificacoes         Notificacao[]
  // Liberações de prazo por aluno+semestre (usadas na abertura, antes de existir TCC).
  liberacoesPrazo      LiberacaoPrazo[] @relation("LiberacaoAluno")
  // Participação em TCCs já arquivados (professor/coordenador). É o que mantém o histórico
  // filtrável por usuário DEPOIS que as contas de aluno/avaliador externo são apagadas.
  arquivadosParticipando TccArquivadoParticipante[]

  @@map("usuarios")
}

// Notificação interna (sino/central). Sistema separado do e-mail e das suas
// preferências. Sempre pertence a um usuário — ninguém vê a de outro.
model Notificacao {
  id        String    @id @default(cuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  evento    String
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean   @default(false)
  criadoEm  DateTime  @default(now())
  lidaEm    DateTime?

  @@index([usuarioId, lida])
  @@map("notificacoes")
}

// Configuração GLOBAL de envio de e-mail (linha única). Dois interruptores:
// recuperação de senha e e-mails normais do fluxo do TCC.
model ConfiguracaoEmail {
  id                    String   @id @default("global")
  recuperacaoSenhaAtiva Boolean  @default(true)
  fluxoTccAtivo         Boolean  @default(true)

  // SMTP configurável pela UI (substitui o .env quando smtpHost estiver setado).
  // A senha é guardada CRIPTOGRAFADA (AES-256-GCM); nunca em texto puro.
  smtpHost               String?
  smtpPort               Int?
  smtpSecure             Boolean @default(false)
  smtpUsuario            String?
  smtpRemetente          String?
  smtpSenhaCriptografada String?

  atualizadoEm          DateTime @updatedAt
  criadoEm              DateTime @default(now())

  @@map("configuracao_email")
}

// Configuração geral do sistema (linha única, id "global"). Guarda o período/semestre ATIVO
// definido MANUALMENTE pela coordenação — o sistema não troca de semestre pela data do relógio.
model ConfiguracaoSistema {
  id            String   @id @default("global")
  semestreAtivo String?
  atualizadoEm  DateTime @updatedAt
  criadoEm      DateTime @default(now())

  @@map("configuracao_sistema")
}

// Preferência individual por usuário e tipo de evento (só vale para e-mails de
// fluxo; recuperação de senha não depende disso). Sem linha = padrão LIGADO.
model PreferenciaEmail {
  id        String  @id @default(cuid())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  evento    String
  ativo     Boolean @default(true)

  @@unique([usuarioId, evento])
  @@map("preferencias_email")
}

// Token de recuperação de senha (uso único, prazo curto). Guardamos só o HASH do
// token; o valor cru vai apenas no link enviado por e-mail.
model TokenSenha {
  id        String    @id @default(cuid())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  @@map("tokens_senha")
}

// Código que controla quem pode se cadastrar, por tipo de usuário.
model CodigoCadastro {
  id           String   @id @default(cuid())
  papel        String   @unique
  codigo       String
  atualizadoEm DateTime @updatedAt

  @@map("codigos_cadastro")
}

model Tcc {
  id        String @id @default(cuid())
  titulo    String
  semestre  String
  faseAtual String @default("INICIALIZACAO")

  // Trilhas paralelas da fase de Desenvolvimento (junção "E" → forma a banca).
  monografiaAprovada     Boolean @default(false)
  continuidadeConfirmada Boolean @default(false)
  parecerContinuidade    String? // motivo, quando o orientador rejeita a continuidade

  // Fase em que o TCC estava ANTES de ser descontinuado (edição administrativa). Ao sair de
  // DESCONTINUADO, a coordenação volta para esta fase (e não sempre para DESENVOLVIMENTO).
  faseAnteriorDescontinuacao String?

  // Notas (apuradas pela coordenação). NF = 0,6·NF1 + 0,4·NF2; resultado = APROVADO | REPROVADO.
  nf1       Float?
  nf2       Float?
  nf        Float?
  resultado String?

  // Agendamento da defesa (Fase II): o orientador marca data/hora (UTC), local e comentário.
  // A avaliação da banca abre automaticamente quando o horário chega; a liberação é
  // idempotente (registrada em defesaLiberadaEm — nunca regride nem notifica duas vezes).
  defesaAgendadaPara DateTime?
  defesaLocal        String?
  defesaComentario   String?
  defesaAgendadaEm   DateTime?
  defesaLiberadaEm   DateTime?

  // Datas REAIS em que cada ato do fluxo aconteceu (preenchidas no momento da ação).
  // Usadas pela timeline. Ficam null para registros antigos (não há data confiável).
  monografiaAprovadaEm   DateTime?
  continuidadeAvaliadaEm DateTime?
  fase1ValidadaEm        DateTime?
  fase2ValidadaEm        DateTime?
  versaoFinalValidadaEm  DateTime?
  concluidoEm            DateTime?

  aluno   Usuario @relation("TccAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId String

  orientador   Usuario? @relation("TccOrientador", fields: [orientadorId], references: [id])
  orientadorId String?

  // Coorientador cadastrado no sistema (interno)...
  coorientador   Usuario? @relation("TccCoorientador", fields: [coorientadorId], references: [id])
  coorientadorId String?
  // ...ou externo (campos soltos)
  coorientadorNome      String?
  coorientadorTitulacao String?
  coorientadorAfiliacao String?
  coorientadorLattes    String?

  // Exclusão lógica (soft delete) pela coordenação ou pelo orientador. Um TCC excluído
  // some das listas/fluxos ativos, mas NADA é apagado fisicamente: documentos, bancas,
  // avaliações, notas e arquivos do disco permanecem (histórico/exportação preservados).
  // excluidoPorId é o id do usuário que excluiu (sem FK, para migration mínima).
  excluidoEm     DateTime?
  excluidoPorId  String?
  motivoExclusao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  solicitacoes SolicitacaoOrientacao[]
  documentos   DocumentoTcc[]
  bancas       Banca[]
  liberacoesPrazo LiberacaoPrazo[]
  // Fila e mapeamento do Google Drive: Cascade garante que apagar o TCC no encerramento
  // não deixe item de fila nem mapeamento apontando para TCC/documento inexistente.
  sincronizacoesDrive SyncDrive[]
  arquivosDrive       DriveArquivo[]

  @@unique([alunoId, semestre])
  @@map("tccs")
}

// Ocultação INDIVIDUAL de um TCC no histórico de UM usuário (preferência por usuário/perfil).
// NÃO é exclusão: não mexe no TCC nem em `excluidoEm`, não apaga documentos/notas/bancas/
// arquivos/usuários. Só esconde o TCC do histórico DAQUELE usuário — se o professor oculta,
// o coordenador ainda vê, e vice-versa.
//
// A exclusão administrativa GLOBAL continua sendo `Tcc.excluidoEm` (soft delete), que tira o
// TCC de TODOS os históricos/listas/fluxos. Hard delete definitivo NÃO existe (etapa futura).
model HistoricoTccOculto {
  id        String   @id @default(cuid())
  usuarioId String
  tccId     String
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, tccId])
  @@map("historico_tcc_oculto")
}

// Liberação individual de prazo dada pela coordenação para um TCC/aluno específico,
// permitindo uma ação fora do prazo global sem mexer no calendário do semestre.
// A PRESENÇA da linha = liberado; remover a linha = volta a respeitar o prazo.
// Escopo por TCC (etapas que já têm TCC) OU por aluno+semestre (ENVIO_DOCUMENTOS,
// que pode ocorrer antes de o TCC existir). Etapa = chave de ETAPAS_PRAZO.
model LiberacaoPrazo {
  id    String @id @default(cuid())
  etapa String

  tcc   Tcc?    @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId String?

  aluno    Usuario? @relation("LiberacaoAluno", fields: [alunoId], references: [id], onDelete: Cascade)
  alunoId  String?
  semestre String?

  criadoEm DateTime @default(now())

  @@unique([tccId, etapa])
  @@unique([alunoId, semestre, etapa])
  @@map("liberacoes_prazo")
}

model SolicitacaoOrientacao {
  id       String  @id @default(cuid())
  tcc      Tcc     @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId    String
  mensagem String?
  status   String  @default("PENDENTE") // PENDENTE | ACEITA | RECUSADA | CANCELADA
  parecer  String? // parecer do coordenador ao recusar

  criadoEm     DateTime  @default(now())
  respondidoEm DateTime?

  @@map("solicitacoes_orientacao")
}

model DocumentoTcc {
  id          String @id @default(cuid())
  tcc         Tcc    @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId       String
  tipo        String // PLANO_DESENVOLVIMENTO | TERMO_ACEITE | MONOGRAFIA | ...
  nomeArquivo String
  caminho     String
  tamanho     Int
  versao      Int    @default(1)
  status      String @default("PENDENTE")
  parecer     String? // devolutiva do orientador (ex.: ao rejeitar a monografia)
  criadoEm    DateTime @default(now())

  // Quando este documento é o "documento para avaliação" enviado pelo coordenador
  // ao formar uma banca (tipo AVALIACAO_BANCA), aponta de volta para essa banca.
  bancaDocumento Banca? @relation("BancaDocumento")

  @@map("documentos_tcc")
}

// Banca avaliadora de um TCC numa fase. Fase I = 2 avaliadores; Fase II = 3.
model Banca {
  id       String @id @default(cuid())
  tcc      Tcc    @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId    String
  fase     String // FASE_1 | FASE_2
  criadoEm DateTime @default(now())

  // Documento que a banca deve avaliar, enviado manualmente pelo coordenador ao
  // formar a banca (tipo AVALIACAO_BANCA). Quando existe, substitui a monografia
  // original como documento de avaliação para os membros da banca.
  documentoAvaliacaoId String?       @unique
  documentoAvaliacao   DocumentoTcc? @relation("BancaDocumento", fields: [documentoAvaliacaoId], references: [id])

  membros MembroBanca[]

  @@unique([tccId, fase])
  @@map("bancas")
}

model MembroBanca {
  id          String   @id @default(cuid())
  banca       Banca    @relation(fields: [bancaId], references: [id], onDelete: Cascade)
  bancaId     String
  avaliador   Usuario  @relation(fields: [avaliadorId], references: [id])
  avaliadorId String
  nota        Float? // total (soma dos critérios), 0–10, null em rascunho/não enviada

  // Status da avaliação:
  //  PENDENTE          rascunho/não enviada (editável na fase de avaliação)
  //  ENVIADO           enviada (editável enquanto AVALIACAO/AGUARDANDO_ANALISE)
  //  EM_ANALISE        coordenação iniciou a análise (travada; sem edição do avaliador)
  //  AJUSTE_SOLICITADO coordenação pediu ajuste a este membro (só ele pode reenviar)
  //  APROVADO          avaliação aprovada pela coordenação
  //  BLOQUEADO         prazo vencido sem liberação | CONCLUIDO fase validada (travada)
  status      String @default("PENDENTE")

  // Motivo do último ajuste solicitado pela coordenação (mostrado ao avaliador). Null quando
  // não há ajuste pendente. Não vaza nota; é texto livre do coordenador.
  ajusteMotivo String?

  // Quando o avaliador REENVIOU a avaliação após um ajuste solicitado e a coordenação ainda
  // não decidiu (aprovar / novo ajuste / validar a fase). Alimenta a ação pendente do
  // dashboard do coordenador; é limpo na decisão. Null = nada aguardando.
  ajusteReenviadoEm DateTime?

  // Notas por critério (Fase I usa os 5 primeiros; Fase II usa os 5 últimos).
  notaResumo          Float?
  notaIntroducao      Float?
  notaRevisao         Float?
  notaDesenvolvimento Float?
  notaConclusoes      Float?
  notaCoerencia       Float?
  notaQualidade       Float?
  notaDominio         Float?
  notaClareza         Float?
  notaObservancia     Float?

  parecer     String?
  avaliadoEm  DateTime?

  // Rascunho PRIVADO do avaliador (JSON: { notas, parecer }). NÃO é exposto ao coordenador —
  // fica separado das colunas oficiais (notaX/parecer/nota) para que o rascunho só apareça
  // para o próprio avaliador até o ENVIO final. Limpo (null) ao enviar.
  rascunho    String?

  @@unique([bancaId, avaliadorId])
  @@map("membros_banca")
}

// Calendário do semestre (datas-marco), definido pela coordenação. Um por semestre.
model Calendario {
  id       String @id @default(cuid())
  semestre String @unique

  reuniaoAlunos         DateTime?
  envioDocumentos       DateTime?
  avaliacaoContinuidade DateTime?
  submissaoMonografia   DateTime?
  preparacaoBancasFase1 DateTime?
  avaliacaoFase1        DateTime?
  preparacaoBancasFase2 DateTime?
  apresentacaoFase2     DateTime?
  ajustesFinais         DateTime?

  // Pesos por critério das avaliações (cada fase soma 10). Defaults do regulamento.
  pesoResumo          Float @default(1.0)
  pesoIntroducao      Float @default(2.0)
  pesoRevisao         Float @default(2.0)
  pesoDesenvolvimento Float @default(3.5)
  pesoConclusoes      Float @default(1.5)
  pesoCoerencia       Float @default(2.0)
  pesoQualidade       Float @default(2.0)
  pesoDominio         Float @default(2.5)
  pesoClareza         Float @default(2.5)
  pesoObservancia     Float @default(1.0)

  // Pesos das FASES na nota final: NF = pesoFase1·NF1 + pesoFase2·NF2 (soma = 1). Defaults 60/40.
  pesoFase1 Float @default(0.6)
  pesoFase2 Float @default(0.4)

  atualizadoEm DateTime @updatedAt

  @@map("calendarios")
}

// Documentos-modelo disponibilizados pela coordenação (Orientações, Template, ABNT…).
model DocumentoReferencia {
  id          String   @id @default(cuid())
  titulo      String
  nomeArquivo String
  caminho     String
  tamanho     Int
  // Perfis que podem ver o documento (CSV: ALUNO,PROFESSOR,AVALIADOR). Coordenador sempre vê.
  visivelPara String   @default("ALUNO,PROFESSOR,AVALIADOR")
  criadoEm    DateTime @default(now())

  @@map("documentos_referencia")
}

// Avisos do mural, publicados pela coordenação.
model Aviso {
  id        String   @id @default(cuid())
  titulo    String
  conteudo  String
  // Cor do card: '' | azul | verde | amarelo | vermelho | roxo | laranja
  cor       String   @default("")
  // Perfis que veem o aviso (CSV). Coordenador sempre vê.
  destinatarios String @default("ALUNO,PROFESSOR,AVALIADOR,COORDENADOR")
  fixado    Boolean  @default(false)
  autorId   String?
  autorNome String?
  criadoEm  DateTime @default(now())

  comentarios ComentarioAviso[]

  @@map("avisos")
}

// Comentários nos avisos (qualquer usuário logado; apaga o autor ou o coordenador).
model ComentarioAviso {
  id        String   @id @default(cuid())
  aviso     Aviso    @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  avisoId   String
  autorId   String
  autorNome String
  texto     String
  criadoEm  DateTime @default(now())

  @@map("comentarios_aviso")
}

// ---------- Arquivamento no Google Drive ----------

// Integração GLOBAL com o Drive da conta institucional (linha única "global"), igual ao
// padrão de ConfiguracaoEmail. É compartilhada por todos os coordenadores.
//
// O refresh token é guardado CRIPTOGRAFADO com chave PRÓPRIA (DRIVE_CRYPTO_SEGREDO) —
// separada do JWT e da chave de e-mail, para que girar uma não invalide as outras.
// A pasta raiz é CRIADA pelo próprio sistema: com o escopo drive.file o app só enxerga
// o que ele mesmo criou, então não há como apontar uma pasta pré-existente.
model IntegracaoDrive {
  id                        String    @id @default("global")
  contaEmail                String?
  pastaRaizId               String?
  pastaRaizNome             String?
  refreshTokenCriptografado String?
  conectadoEm               DateTime?
  ultimoSyncEm              DateTime?
  ultimoErro                String?

  // Proteção CSRF do callback OAuth: state de uso único e com validade curta.
  oauthState         String?
  oauthStateExpiraEm DateTime?

  atualizadoEm DateTime @updatedAt

  @@map("integracao_drive")
}

// Fila persistente de sincronização. O fluxo acadêmico só ENFILEIRA (nunca espera o Drive),
// e um worker processa com backoff. Cascade no TCC: encerrar o período e apagar o TCC não
// deixa item órfão apontando para TCC/documento inexistente.
model SyncDrive {
  id    String @id @default(cuid())
  tcc   Tcc    @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId String

  // PASTA | DOC_INICIAL | DOCUMENTO | DADOS | PODA_FINAL
  tipo String
  // Identidade do alvo dentro do TCC ("PASTA", "DADOS", "DOC:<documentoId>"): evita
  // enfileirar duas vezes a mesma coisa enquanto a anterior não foi processada.
  chave       String
  documentoId String?

  // PENDENTE | PROCESSANDO | CONCLUIDO | ERRO
  status             String   @default("PENDENTE")
  tentativas         Int      @default(0)
  ultimoErro         String?
  proximaTentativaEm DateTime @default(now())

  // Reserva atômica do item: quem consegue gravar o próprio `reservaId` (updateMany
  // condicional que casa exatamente 1 linha) é o dono do processamento. Impede o worker
  // automático e o botão "tentar de novo" de subirem o mesmo arquivo duas vezes.
  // `reservadoEm` permite recuperar item travado se a API reiniciar no meio do envio.
  reservaId   String?
  reservadoEm DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Uma linha por alvo: o enfileiramento é upsert, então duas ações simultâneas sobre o
  // mesmo TCC/chave reaproveitam o item em vez de criar fila duplicada.
  @@unique([tccId, chave])
  @@index([status, proximaTentativaEm])
  @@map("sync_drive")
}

// Mapa TCC/documento -> id do arquivo no Drive. Garante idempotência (não reenvia o que já
// subiu) e permite atualizar dados.json/resumo.txt no lugar em vez de duplicar.
model DriveArquivo {
  id    String @id @default(cuid())
  tcc   Tcc    @relation(fields: [tccId], references: [id], onDelete: Cascade)
  tccId String

  // "PASTA" | "DADOS_JSON" | "RESUMO_TXT" | "DOC:<documentoId>"
  chave   String
  driveId String
  nome    String

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tccId, chave])
  @@map("drive_arquivos")
}

// Histórico INDEPENDENTE das contas. Criado no encerramento do período, ANTES de apagar
// qualquer coisa. Não tem FK para o TCC nem para aluno/avaliador — os dados dessas pessoas
// ficam em texto e no snapshot, para que o histórico sobreviva à exclusão das contas.
model TccArquivado {
  id String @id @default(cuid())
  // Referência textual (o TCC original é apagado). ÚNICA: se dois coordenadores encerrarem
  // o mesmo período ao mesmo tempo, o segundo esbarra aqui em vez de duplicar o histórico.
  tccIdOriginal String @unique

  semestre String
  titulo   String

  // Pessoas cujas contas podem ser apagadas: guardadas em TEXTO.
  alunoNome        String
  alunoEmail       String
  alunoCurso       String?
  orientadorNome   String?
  coorientadorNome String?

  nf1                Float?
  nf2                Float?
  nf                 Float?
  resultado          String?
  faseFinal          String?
  concluidoEm        DateTime?
  defesaAgendadaPara DateTime?
  defesaLocal        String?

  // Retrato completo e legível (mesmo conteúdo que vai para o Drive).
  dadosJson   String
  resumoTexto String

  // Arquivo LOCAL permanente (a garantia do encerramento): pasta própria na VPS, fora de
  // uploads/, com os documentos copiados e validados. É daqui que o Histórico serve os
  // downloads — não depende do Drive nem das contas apagadas.
  pastaArquivo   String?
  arquivadoLocalEm DateTime?

  // Ponteiros no Drive (cópia ADICIONAL e opcional; sem link público).
  drivePastaId          String?
  driveArquivoFinalId   String?
  driveArquivoFinalNome String?

  arquivadoEm DateTime @default(now())

  documentos    DocumentoArquivado[]
  participantes TccArquivadoParticipante[]

  @@index([semestre])
  @@map("tccs_arquivados")
}

// Trava PERSISTENTE de encerramento por período. Enquanto existe uma linha ENCERRANDO,
// nenhuma criação/alteração de TCC ou documento daquele semestre é aceita (409) — sem isso,
// um TCC criado no meio do processo seria apagado sem ter sido arquivado.
//
// `semestre` é único: é a própria criação da linha que serve de reserva atômica (duas
// tentativas simultâneas → a segunda esbarra na constraint). Falha remove a linha;
// sucesso muda para ENCERRADO.
model PeriodoEncerramento {
  id       String @id @default(cuid())
  semestre String @unique

  // ENCERRANDO | ENCERRADO
  status       String    @default("ENCERRANDO")
  iniciadoPorId String?
  iniciadoEm   DateTime  @default(now())
  concluidoEm  DateTime?

  @@map("periodos_encerramento")
}

// Cópia permanente de um documento do TCC na área de arquivamento local. `sha256` e
// `tamanho` são gravados na cópia e reconferidos antes de qualquer exclusão — é essa
// validação que autoriza o encerramento a apagar os dados ativos.
model DocumentoArquivado {
  id          String       @id @default(cuid())
  arquivado   TccArquivado @relation(fields: [arquivadoId], references: [id], onDelete: Cascade)
  arquivadoId String

  tipo        String
  nomeArquivo String // nome original, mostrado ao usuário
  versao      Int
  status      String
  caminho     String // caminho relativo do arquivo copiado (área de arquivamento)
  tamanho     Int
  sha256      String

  // Documento acadêmico principal do TCC (versão final aprovada; sem ela, a monografia
  // mais recente). É o que o Histórico oferece em destaque e o que vai para o Drive.
  ehFinal Boolean @default(false)

  // Preenchido só quando a cópia adicional no Drive existe.
  driveId String?

  criadoEm DateTime @default(now())

  @@unique([arquivadoId, tipo, versao])
  @@map("documentos_arquivados")
}

// Quem (professor/coordenador) participou do TCC arquivado. Só entram papéis cujas contas
// NUNCA são apagadas — é isso que faz o "Histórico" de cada professor continuar funcionando
// depois que aluno e avaliador externo somem.
model TccArquivadoParticipante {
  id          String       @id @default(cuid())
  arquivado   TccArquivado @relation(fields: [arquivadoId], references: [id], onDelete: Cascade)
  arquivadoId String
  usuario     Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId   String

  // ORIENTADOR | COORIENTADOR | BANCA
  papel String

  @@unique([arquivadoId, usuarioId, papel])
  @@map("tccs_arquivados_participantes")
}
