# Banco de dados.
# Desenvolvimento (SQLite, arquivo local):
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL) seria algo como:
# DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo usado para assinar os tokens de login (troque por um texto aleatório longo).
# Em produção (NODE_ENV=production) é OBRIGATÓRIO — a API não inicia sem ele.
JWT_SEGREDO="troque-por-um-segredo-bem-grande-e-aleatorio"

# Ambiente: "production" ativa cookie seguro (HTTPS) e exige JWT_SEGREDO.
NODE_ENV=development

# Origens permitidas no CORS (separadas por vírgula). Padrão: Vite local.
CORS_ORIGENS="http://localhost:5173"

# Porta da API
PORT=3000

# URL pública do front (usada para montar o link de recuperação de senha).
APP_URL="http://localhost:5173"

# Chave para criptografar a senha de app do SMTP quando configurada pela tela do
# coordenador (AES-256-GCM). Se ausente, cai no JWT_SEGREDO. Em produção, defina
# uma chave dedicada e estável (trocar a chave invalida senhas já salvas).
EMAIL_CRYPTO_SEGREDO="troque-por-uma-chave-dedicada-para-e-mail"

# Envio de e-mail (recuperação de senha). O SMTP também pode ser configurado pela
# tela do coordenador (Planejamento), que tem prioridade sobre estas variáveis.
# SEM SMTP_HOST (aqui e na tela) -> modo dev/console: o e-mail NÃO é enviado, só é
# registrado no log (com o link). Preencha os campos abaixo para enviar de verdade.
# SMTP_HOST="smtp.seuprovedor.com"
# SMTP_PORT=587
# SMTP_SECURE=false           # true para porta 465 (SSL)
# SMTP_USER="usuario@dominio"
# SMTP_PASS="senha-ou-app-password"
# SMTP_FROM="Sistema de TCC <nao-responda@dominio>"
